<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">freewindow</string>

    <string name="settings_title">freewindow 设置</string>
    <string name="settings_subtitle">自由小窗装饰项，可独立开关</string>

    <string name="hide_bottom_bar_title">隐藏窗口白条</string>
    <string name="hide_bottom_bar_desc">隐藏自由小窗底部的白色手势横条</string>

    <string name="hide_three_dot_title">隐藏三点菜单栏</string>
    <string name="hide_three_dot_desc">移除顶部三点按钮（视觉、点击、触摸穿透）</string>

    <string name="enable_dock_title">启用坞窗</string>
    <string name="enable_dock_desc">点击悬浮球弹出坞窗卡片；关闭后按系统默认恢复迷你浮窗</string>

    <string name="settings_hint">功能开关每次重启手机后会恢复为全部打开；主题会记住你的选择。改开关后重新打开自由小窗即可生效</string>

    <string name="theme_title">界面主题</string>
    <string name="theme_desc">开启浅色主题，关闭为深色主题</string>
</resources>
